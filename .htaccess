# ===== TMPortugal — static site (no WordPress, no PHP) =====

# Serve the static homepage
DirectoryIndex index.html

# Force HTTPS + canonical non-www (tmportugal.com)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://tmportugal.com%{REQUEST_URI} [L,R=301]
</IfModule>

# Do not execute PHP anywhere in the docroot (belt-and-suspenders after WP removal)
<FilesMatch "\.(php|php3|php4|php5|php7|phtml|pl|py|cgi|asp|sh)$">
  Require all denied
</FilesMatch>

# Block access to hidden/sensitive files
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Friendly error pages fall back to the homepage
ErrorDocument 404 /index.html

# Basic caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
